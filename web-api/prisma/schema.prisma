generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// UUIDs are generated by Prisma Client, never by a database default.
// @updatedAt maintains updates through Prisma; raw SQL writers must set updated_at.
// CHECK constraints and the reporting-period exclusion live in migration SQL.

enum ReportStatus {
  DRAFT
  SUBMITTED
  NEEDS_CORRECTION
  APPROVED

  @@map("report_status")
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED

  @@map("review_decision")
}

enum TaskSection {
  THIS_WEEK
  NEXT_WEEK

  @@map("task_section")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED

  @@map("task_status")
}

enum TaskType {
  DEVELOPMENT
  TESTING
  MEETINGS
  DOCUMENTATION
  OTHER

  @@map("task_type")
}

enum BlockerStatus {
  OPEN
  RESOLVED

  @@map("blocker_status")
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("email_delivery_status")
}

enum NotificationType {
  REPORT_SUBMITTED
  REPORT_RESUBMITTED
  REPORT_APPROVED
  REPORT_NEEDS_CORRECTION
  TASK_ASSIGNED

  @@map("notification_type")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  roleId        String    @map("role_id") @db.Uuid
  employeeId    String    @unique @map("employee_id") @db.VarChar(30)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  email         String    @unique @db.VarChar(254)
  passwordHash  String?   @map("password_hash") @db.Text
  position      String?   @db.VarChar(100)
  contactNumber String?   @map("contact_number") @db.VarChar(30)
  personalEmail String?   @map("personal_email") @db.VarChar(254)
  addressLine1  String?   @map("address_line_1") @db.VarChar(255)
  addressLine2  String?   @map("address_line_2") @db.VarChar(255)
  city          String?   @db.VarChar(100)
  postalCode    String?   @map("postal_code") @db.VarChar(20)
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)

  role                  Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reportingPeriods      UserReportingPeriod[]
  authSessions          AuthSession[]
  invitations           UserInvitation[]      @relation("InvitedUser")
  sentInvitations       UserInvitation[]      @relation("InvitationSender")
  createdTasks          Task[]                @relation("TaskCreator")
  assignedTasks         Task[]                @relation("TaskAssignee")
  timeEntries           TaskTimeEntry[]
  reports               Report[]
  reportReviews         ReportReview[]
  receivedNotifications Notification[]        @relation("NotificationRecipient")
  actedNotifications    Notification[]        @relation("NotificationActor")
  projectMemberships    ProjectMember[]

  @@index([roleId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("users")
}

model UserReportingPeriod {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  startWeek DateTime  @map("start_week") @db.Date
  endWeek   DateTime? @map("end_week") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, startWeek])
  @@map("user_reporting_periods")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent        String?   @map("user_agent") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model UserInvitation {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  invitedBy           String              @map("invited_by") @db.Uuid
  tokenHash           String              @unique @map("token_hash") @db.Char(64)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt           DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt          DateTime?           @map("consumed_at") @db.Timestamptz(6)
  revokedAt           DateTime?           @map("revoked_at") @db.Timestamptz(6)
  emailDeliveryStatus EmailDeliveryStatus @default(PENDING) @map("email_delivery_status")
  emailSentAt         DateTime?           @map("email_sent_at") @db.Timestamptz(6)
  emailAttemptCount   Int                 @default(0) @map("email_attempt_count")

  user   User @relation("InvitedUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sender User @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId], map: "user_invitations_outstanding_key", where: raw("(consumed_at IS NULL AND revoked_at IS NULL)"))
  @@index([userId, createdAt(sort: Desc)])
  @@index([invitedBy])
  @@index([emailDeliveryStatus, createdAt])
  @@map("user_invitations")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(150)
  clientName  String?   @map("client_name") @db.VarChar(150)
  description String?   @db.Text
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  tasks       Task[]
  reportTasks ReportTask[]
  members     ProjectMember[]

  @@index([archivedAt, name, id])
  @@map("projects")
}

model ProjectMember {
  projectId  String   @map("project_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([projectId, userId])
  @@index([userId, projectId])
  @@map("project_members")
}

model Task {
  id                   String       @id @default(uuid()) @db.Uuid
  createdBy            String       @map("created_by") @db.Uuid
  assigneeId           String       @map("assignee_id") @db.Uuid
  projectId            String       @map("project_id") @db.Uuid
  name                 String       @db.VarChar(255)
  description          String?      @db.Text
  plannedDate          DateTime     @map("planned_date") @db.Date
  dueDate              DateTime?    @map("due_date") @db.Date
  priority             TaskPriority @default(MEDIUM)
  status               TaskStatus   @default(NOT_STARTED)
  taskType             TaskType     @default(OTHER) @map("task_type")
  plannedCompletionPct Decimal      @default(100) @map("planned_completion_pct") @db.Decimal(5, 2)
  actualCompletionPct  Decimal      @default(0) @map("actual_completion_pct") @db.Decimal(5, 2)
  plannedMinutes       Int          @default(0) @map("planned_minutes")
  deliverable          String?      @db.Text
  completedAt          DateTime?    @map("completed_at") @db.Timestamptz(6)
  lockVersion          Int          @default(1) @map("lock_version")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt           DateTime?    @map("archived_at") @db.Timestamptz(6)

  creator       User            @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignee      User            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  timeEntries   TaskTimeEntry[]
  reportTasks   ReportTask[]
  notifications Notification[]

  @@index([assigneeId, plannedDate, id])
  @@index([projectId, plannedDate, id])
  @@index([plannedDate, id])
  @@index([createdBy])
  @@map("tasks")
}

model TaskTimeEntry {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  workDate  DateTime @map("work_date") @db.Date
  minutes   Int
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([taskId, workDate])
  @@index([userId, workDate, id])
  @@map("task_time_entries")
}

model Report {
  id        String       @id @default(uuid()) @db.Uuid
  memberId  String       @map("member_id") @db.Uuid
  weekStart DateTime     @map("week_start") @db.Date
  status    ReportStatus @default(DRAFT)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  member   User            @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions ReportVersion[]

  @@unique([memberId, weekStart])
  @@index([weekStart, status, memberId])
  @@index([memberId, weekStart(sort: Desc), id])
  @@map("reports")
}

model ReportVersion {
  id            String    @id @default(uuid()) @db.Uuid
  reportId      String    @map("report_id") @db.Uuid
  versionNumber Int       @map("version_number")
  notes         String?   @db.Text
  lockVersion   Int       @default(1) @map("lock_version")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(6)

  report        Report              @relation(fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tasks         ReportTask[]
  blockers      ReportBlocker[]
  achievements  ReportAchievement[]
  review        ReportReview?
  notifications Notification[]

  @@unique([reportId, versionNumber])
  @@unique([reportId], map: "report_versions_editable_key", where: raw("(submitted_at IS NULL)"))
  @@index([reportId, submittedAt(sort: Desc)], map: "report_versions_submitted_idx", where: raw("(submitted_at IS NOT NULL)"))
  @@map("report_versions")
}

// Weekly snapshots deliberately retain their own content and nullable draft fields.
model ReportTask {
  id                   String       @id @default(uuid()) @db.Uuid
  reportVersionId      String       @map("report_version_id") @db.Uuid
  sourceTaskId         String?      @map("source_task_id") @db.Uuid
  sourceTaskDescription String?     @map("source_task_description") @db.Text
  sourceTaskPlannedDate DateTime?   @map("source_task_planned_date") @db.Date
  sourceTaskDueDate     DateTime?   @map("source_task_due_date") @db.Date
  sourceTaskAssigneeName String?    @map("source_task_assignee_name") @db.VarChar(201)
  projectId            String?      @map("project_id") @db.Uuid
  projectNameSnapshot  String?      @map("project_name_snapshot") @db.VarChar(150)
  section              TaskSection
  name                 String       @db.VarChar(255)
  priority             TaskPriority @default(MEDIUM)
  status               TaskStatus?
  plannedCompletionPct Decimal?     @map("planned_completion_pct") @db.Decimal(5, 2)
  actualCompletionPct  Decimal?     @map("actual_completion_pct") @db.Decimal(5, 2)
  plannedMinutes       Int?         @map("planned_minutes")
  actualMinutes        Int?         @map("actual_minutes")
  taskType             TaskType     @default(OTHER) @map("task_type")
  deliverable          String?      @db.Text
  displayOrder         Int          @map("display_order")

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceTask    Task?         @relation(fields: [sourceTaskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([reportVersionId, sourceTaskId, section], map: "report_tasks_imported_key", where: raw("(source_task_id IS NOT NULL)"))
  @@index([reportVersionId])
  @@index([projectId])
  @@index([sourceTaskId], map: "report_tasks_source_task_idx", where: raw("(source_task_id IS NOT NULL)"))
  @@map("report_tasks")
}

model ReportBlocker {
  id              String        @id @default(uuid()) @db.Uuid
  reportVersionId String        @map("report_version_id") @db.Uuid
  description     String        @db.Text
  isKey           Boolean       @default(false) @map("is_key")
  status          BlockerStatus @default(OPEN)
  displayOrder    Int           @map("display_order")

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([reportVersionId], map: "report_blockers_key_item_key", where: raw("(is_key = true)"))
  @@index([reportVersionId])
  @@map("report_blockers")
}

model ReportAchievement {
  id              String  @id @default(uuid()) @db.Uuid
  reportVersionId String  @map("report_version_id") @db.Uuid
  description     String  @db.Text
  isKey           Boolean @default(false) @map("is_key")
  displayOrder    Int     @map("display_order")

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([reportVersionId], map: "report_achievements_key_item_key", where: raw("(is_key = true)"))
  @@index([reportVersionId])
  @@map("report_achievements")
}

model ReportReview {
  id              String         @id @default(uuid()) @db.Uuid
  reportVersionId String         @unique @map("report_version_id") @db.Uuid
  reviewerId      String         @map("reviewer_id") @db.Uuid
  decision        ReviewDecision
  comment         String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  reportVersion        ReportVersion  @relation(fields: [reportVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer             User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notifications        Notification[] @relation("NotificationReview")
  versionNotifications Notification[] @relation("NotificationReviewVersion")

  @@unique([id, reportVersionId])
  @@index([reviewerId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("report_reviews")
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  recipientId     String           @map("recipient_id") @db.Uuid
  actorId         String           @map("actor_id") @db.Uuid
  eventKey        String           @map("event_key") @db.Uuid
  type            NotificationType
  reportVersionId String?          @map("report_version_id") @db.Uuid
  reportReviewId  String?          @map("report_review_id") @db.Uuid
  taskId          String?          @map("task_id") @db.Uuid
  title           String           @db.VarChar(255)
  message         String           @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt          DateTime?        @map("read_at") @db.Timestamptz(6)

  recipient     User           @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor         User           @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reportVersion ReportVersion? @relation(fields: [reportVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reportReview  ReportReview?  @relation("NotificationReview", fields: [reportReviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewVersion ReportReview?  @relation("NotificationReviewVersion", fields: [reportReviewId, reportVersionId], references: [id, reportVersionId], onDelete: Restrict, onUpdate: Restrict, map: "notifications_review_version_fkey")
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recipientId, eventKey])
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_unread_idx", where: raw("(read_at IS NULL)"))
  @@index([actorId])
  @@index([reportVersionId])
  @@index([reportReviewId, reportVersionId])
  @@index([taskId])
  @@map("notifications")
}
