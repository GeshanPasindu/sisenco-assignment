# Copy to .env and replace the placeholders. URL-encode the password.
# Keep DATABASE_URL private;.
DATABASE_URL="postgresql://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@localhost:5432/task_manager?schema=task_manager"
NODE_ENV=development
PORT=3001
# Existing application configuration uses this spelling.
CORS_ORIGN=http://localhost:5173

# Run npm run auth:setup for loopback development only. It generates a secret
# directly into ignored .env without printing it or replacing existing values.
JWT_SECRET=
JWT_ISSUER=weekly-report-api
JWT_AUDIENCE=weekly-report-frontend
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_SECONDS=900
REFRESH_SESSION_SECONDS=604800
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Optional SMTP delivery. When omitted or delivery fails, admins receive a
# one-time copyable invitation link instead. Gmail requires an App Password.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASSWORD=your-16-character-gmail-app-password
# SMTP_FROM="Task Manager <your-gmail-address@gmail.com>"
# INVITATION_URL_BASE=http://localhost:5173

# HTTPS deployments: NODE_ENV=production, COOKIE_SECURE=true, exact HTTPS
# frontend origins. Use COOKIE_SAME_SITE=none only for cross-site deployment.
# All auth POSTs require an allowed Origin header, including no-body actions.
# Optional local DB override for auth tests (fixtures cleaned by UUID):
# AUTH_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/TEST_DB?schema=task_manager
