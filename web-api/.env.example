# Copy to .env and replace the placeholders. URL-encode the password.
# Keep DATABASE_URL private; this example contains no real credentials.
DATABASE_URL="postgresql://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@localhost:5432/nest?schema=task_manager"
NODE_ENV=development
PORT=3001
# Existing application configuration uses this spelling.
CORS_ORIGN=http://localhost:5173
